---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import Placeholder from '../components/Placeholder.astro';
import LeadForm from '../components/LeadForm.astro';
import Icon from '../components/Icon.astro';
import { contacts } from '../config/site';
import { breadcrumbSchema } from '../lib/schema';

const crumbs = [{ label: 'Наши работы' }];

const pairs = [
  { label: 'Полировка фар: помутневший рассеиватель и после обработки', icon: 'headlight' as const },
  { label: 'Мойка днища: слой реагента и чистый металл', icon: 'shield' as const },
  { label: 'Химчистка салона: засаленная ткань и после экстракции', icon: 'sofa' as const },
  { label: 'Мойка двигателя: масляный налёт и чистое подкапотное', icon: 'engine' as const },
];

const shots = [
  { label: 'Тонировка чёрной плёнкой задних стёкол тёмно-синего автомобиля', icon: 'film' as const },
  { label: 'Оклейка антигравийной плёнкой: капот с крыльями и фарами', icon: 'film' as const },
  { label: 'Тёмно-синий автомобиль моется густой активной пеной', icon: 'droplet' as const },
  { label: 'Антикоррозийная обработка днища на подъёмнике', icon: 'shield' as const },
  { label: 'Мойка мотора тёмно-синего автомобиля', icon: 'engine' as const },
  { label: 'Результат химчистки салона: ткань сидений после экстракции', icon: 'sofa' as const },
];
---

<Base
  title="Наши работы — фото до и после | Автомойка Лайт Он, Бобруйск"
  description="Результаты работ автомойки и детейлинг-центра «Лайт Он» в Бобруйске: полировка фар, химчистка салона, антикор, тонировка. Фото до и после."
  path="/raboty/"
  schemas={[breadcrumbSchema(crumbs)]}
>
  <Breadcrumbs items={crumbs} />

  <section class="section" style="padding-top:var(--sp-5)">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Было & Стало</p>
        <h1 class="page-title">Посмотрите на результат нашей работы</h1>
        <p>
          Моем. Защищаем от ржавчины. Тонируем. Реставрируем. Возвращаем автомобилю
          безупречный вид. Потяните ползунок, чтобы сравнить состояние до и после.
        </p>
      </div>

      <div class="grid-auto">
        {pairs.map((p) => <BeforeAfter label={p.label} icon={p.icon} />)}
      </div>
    </div>
  </section>

  <section class="section section--tight reveal">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Из бокса</p>
        <h2 style="font-size:var(--fs-2xl)">Как идёт работа</h2>
        <p>
          Ещё больше снимков — в карточке организации на Яндекс.Картах: там
          собран весь фотоархив, включая работы, которые сюда не поместились.
        </p>
      </div>

      <div class="gallery">
        {
          shots.map((s) => (
            <figure>
              <Placeholder label={s.label} icon={s.icon} ratio="4 / 3" />
              <figcaption>{s.label}</figcaption>
            </figure>
          ))
        }
      </div>

      <p style="margin-top:var(--sp-6)">
        <a class="btn btn--ghost" href={contacts.yandexMaps} target="_blank" rel="noopener nofollow">
          Фотоархив на Яндекс.Картах
          <Icon name="arrow" size={16} />
        </a>
      </p>
    </div>
  </section>

  <section class="section section--tight reveal">
    <div class="wrap">
      <div class="cta">
        <div>
          <p class="eyebrow">Ваша машина следующая</p>
          <h2 style="font-size:var(--fs-2xl)">Покажем результат на вашем автомобиле</h2>
          <p class="text-dim" style="margin-top:var(--sp-4)">
            Оставьте номер — перезвоним, уточним, что нужно, и назовём точную
            стоимость. Фотографируем до и после, если вы не против.
          </p>
          <p style="margin-top:var(--sp-5)">
            <a class="btn btn--beam" href={`tel:${contacts.phoneRaw}`}>
              <Icon name="phone" size={18} />
              {contacts.phoneHuman}
            </a>
          </p>
        </div>
        <LeadForm variant="full" id="form-raboty" flat />
      </div>
    </div>
  </section>
</Base>
