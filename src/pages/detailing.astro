---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ServiceCard from '../components/ServiceCard.astro';
import LeadForm from '../components/LeadForm.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import { contacts } from '../config/site';
import { breadcrumbSchema, faqSchema } from '../lib/schema';

const all = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const detailing = all.filter((s) => s.data.detailing);
const crumbs = [{ label: 'Детейлинг' }];

const faq = [
  {
    q: 'Чем детейлинг отличается от обычной мойки?',
    a: 'Мойка возвращает машине чистоту, детейлинг — состояние. Это работа с самими поверхностями: защита лака плёнкой, восстановление прозрачности фар, обработка металла от коррозии, глубокая чистка ткани салона. Мойка занимает полчаса, детейлинг — от нескольких часов до двух дней.',
  },
  {
    q: 'С чего начать, если машине пять лет и её не обслуживали?',
    a: 'Обычно порядок такой: мойка днища и осмотр на коррозию, затем антикор, если есть очаги. Дальше по внешнему виду — полировка фар и химчистка салона дают самый заметный результат за небольшие деньги. Плёнку и тонировку логично делать последними.',
  },
  {
    q: 'Можно ли сделать всё за один заезд?',
    a: 'Частично. Полировка фар, тонировка и химчистка помещаются в один день. Антикоррозийная обработка требует отдельного захода: там сушка и выдержка, которые не ускорить. Составим план по вашей машине при осмотре.',
  },
  {
    q: 'Есть ли скидка на комплекс?',
    a: 'Мы не играем в зачёркнутые цены. Выгода от комплекса в другом: машина сдаётся один раз, подготовительные этапы не дублируются, и вы не платите дважды за мойку перед каждой процедурой.',
  },
];
---

<Base
  title="Детейлинг в Бобруйске — антикор, плёнка, полировка | Лайт Он"
  description="Детейлинг-центр в Бобруйске: антигравийная плёнка от 100 руб., антикор 800 руб., тонировка 300 руб., химчистка 300 руб., полировка фар 100 руб. Минская 123."
  path="/detailing/"
  schemas={[breadcrumbSchema(crumbs), faqSchema(faq)]}
>
  <Breadcrumbs items={crumbs} />

  <section class="section" style="padding-top:var(--sp-5)">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Detailing</p>
        <h1 class="page-title">Детейлинг в Бобруйске</h1>
        <p>
          Детейлинг — это не «помыли получше». Это работа с состоянием поверхностей:
          защитить лак до появления сколов, снять помутнение с фар, остановить
          коррозию до того, как она прошьёт металл, вычистить салон так, чтобы
          пятна не проступили обратно через неделю.
        </p>
      </div>

      <div class="grid-auto">
        {detailing.map((s) => <ServiceCard entry={s} />)}
      </div>
    </div>
  </section>

  <section class="section section--tight reveal">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Порядок работ</p>
        <h2 style="font-size:var(--fs-2xl)">С чего начинать, если делать всё сразу дорого</h2>
        <p>
          Честный порядок приоритетов — от того, что реально спасает машину,
          к тому, что улучшает впечатление от неё.
        </p>
      </div>

      <ol class="steps" style="max-width:52rem">
        <li>
          <h3>Сначала то, что защищает металл</h3>
          <p>
            Мойка днища и антикоррозийная обработка. Ржавчина — единственное
            повреждение из списка, которое со временем становится необратимым.
            Всё остальное можно отложить, это — нет.
          </p>
        </li>
        <li>
          <h3>Потом то, что влияет на безопасность</h3>
          <p>
            Полировка фар. Помутневший рассеиватель рассеивает свет вместо того,
            чтобы класть его на дорогу. Сто рублей и два часа заметно меняют
            ночную езду.
          </p>
        </li>
        <li>
          <h3>Затем то, в чём вы сидите каждый день</h3>
          <p>
            Химчистка салона. Единственная услуга, результат которой вы
            чувствуете в каждой поездке, а не видите раз в неделю на мойке.
          </p>
        </li>
        <li>
          <h3>И в конце — защита и внешний вид</h3>
          <p>
            Антигравийная плёнка и тонировка. Их имеет смысл делать на уже
            приведённой в порядок машине, иначе вы фиксируете плёнкой то
            состояние лака, которое есть сейчас.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section section--tight reveal">
    <div class="wrap">
      <div class="cta">
        <div>
          <p class="eyebrow">Бесплатный осмотр</p>
          <h2 style="font-size:var(--fs-2xl)">Составим план по вашей машине</h2>
          <p class="text-dim" style="margin-top:var(--sp-4)">
            Приезжайте — посмотрим автомобиль и скажем, что нужно делать сейчас,
            что можно отложить на сезон, а что вам вообще не нужно. Осмотр
            ни к чему не обязывает и занимает минут десять.
          </p>
          <p style="margin-top:var(--sp-5)">
            <a class="btn btn--beam" href={`tel:${contacts.phoneRaw}`}>
              <Icon name="phone" size={18} />
              {contacts.phoneHuman}
            </a>
          </p>
        </div>
        <LeadForm variant="full" id="form-detailing" flat />
      </div>
    </div>
  </section>

  <Faq items={faq} />
</Base>
