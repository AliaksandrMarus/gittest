# ─── Кодировка ──────────────────────────────────────────────────────────────
AddDefaultCharset UTF-8

# ─── 301 со старых адресов WordPress ────────────────────────────────────────
# Без них уходит весь накопленный вес старых страниц.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteRule ^home/?$            /                            [R=301,L]
  RewriteRule ^services/?$        /uslugi/                     [R=301,L]
  RewriteRule ^details/?$         /detailing/                  [R=301,L]
  RewriteRule ^realizations/?$    /raboty/                     [R=301,L]
  RewriteRule ^company/?$         /o-kompanii/                 [R=301,L]
  RewriteRule ^contact/?$         /kontakty/                   [R=301,L]

  # Хвосты WordPress: фиды, служебные точки входа и поиск
  RewriteRule ^(.*/)?feed/?$      /                            [R=301,L]
  RewriteRule ^comments/feed/?$   /                            [R=301,L]
  RewriteRule ^wp-json(/.*)?$     /                            [R=301,L]
  RewriteRule ^xmlrpc\.php$       /                            [R=301,L]

  # Единственный канонический вид адреса: https и без www
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

# ─── Кэширование ────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # Хешированные ассеты Astro можно кэшировать навсегда: при изменении
  # содержимого меняется имя файла.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(png|jpg|jpeg|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # HTML всегда свежий — иначе правка цены не доедет до посетителя.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# ─── Сжатие ─────────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ─── Страница 404 ───────────────────────────────────────────────────────────
ErrorDocument 404 /404.html

# ─── Защита служебных файлов обработчика форм ───────────────────────────────
<FilesMatch "^(config\.local\.php|config\.local\.php\.example|leads\.log)$">
  Require all denied
</FilesMatch>
