---
import LeadForm from './LeadForm.astro';
import Icon from './Icon.astro';
import { hours } from '../config/site';
/** Модалка на нативном <dialog>: фокус, Esc и блокировка фона — от браузера. */
---

<dialog class="modal" data-callback-modal aria-labelledby="callback-title">
  <div class="modal__head">
    <div>
      <h2 id="callback-title" style="font-size:var(--fs-xl)">Перезвоним за 5 минут</h2>
      <p>Оставьте номер — диспетчер перезвонит и назовёт цену. {hours.human}.</p>
    </div>
    <button class="modal__close" type="button" data-close-callback aria-label="Закрыть"><Icon name="close" size={18} /></button>
  </div>
  <div class="modal__body">
    <LeadForm variant="callback" id="form-callback" />
  </div>
</dialog>

<script>
  const modal = document.querySelector<HTMLDialogElement>('[data-callback-modal]');
  if (modal) {
    const open = (e: Event) => {
      e.preventDefault();
      modal.showModal();
      modal.querySelector<HTMLInputElement>('input[name="name"]')?.focus();
    };
    document.querySelectorAll('[data-open-callback]').forEach((b) => b.addEventListener('click', open));
    modal.querySelector('[data-close-callback]')?.addEventListener('click', () => modal.close());
    modal.addEventListener('click', (e) => { if (e.target === modal) modal.close(); });
  }
</script>
