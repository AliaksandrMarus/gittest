---
import { contacts, hours } from '../config/site';
import Icon from './Icon.astro';
export interface Props { title?: string; text?: string }
const { title = 'Нужна техника сегодня?', text = `Позвоните — назовём цену и время подачи. ${hours.human}.` } = Astro.props;
---

<section class="band">
  <div class="wrap band__in">
    <div><h2>{title}</h2><p>{text}</p></div>
    <div class="band__cta">
      <a class="btn btn--dark" href={`tel:${contacts.phoneRaw}`}><Icon name="phone" size={18} />{contacts.phoneHuman}</a>
      <button class="btn btn--ghost" type="button" data-open-callback>Перезвоните мне</button>
    </div>
  </div>
</section>
