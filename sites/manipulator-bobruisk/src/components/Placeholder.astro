---
import Icon from './Icon.astro';

/**
 * Заглушка вместо фотографии. Держит раскладку и прямо говорит, какой снимок
 * сюда нужен. Как только файл с нужным именем появится в src/assets/photos/,
 * вместо заглушки встанет фото (см. ASSETS.md).
 */
export interface Props {
  label: string;
  file?: string;
  icon?: Parameters<typeof Icon>[0]['name'];
  ratio?: string;
  class?: string;
}
const { label, file, icon = 'crane', ratio = '4 / 3', class: cls } = Astro.props;
---

<div class:list={['ph', cls]} style={`aspect-ratio:${ratio}`} role="img" aria-label={label}>
  <Icon name={icon} size={40} />
  <span>{label}</span>
  {file && <code>photos/{file}</code>}
</div>

<style>
  .ph {
    display: grid; place-content: center; justify-items: center; gap: 10px; padding: 20px; text-align: center;
    border-radius: var(--r-lg); border: 1px dashed #b9b5aa; color: #6f6c64;
    background: repeating-linear-gradient(135deg, #ece9e1 0 14px, #e4e1d8 14px 28px);
  }
  .ph span { font-size: var(--fs-sm); max-width: 30ch; line-height: 1.45; }
  .ph code { font-size: 12px; background: rgb(255 255 255 / 0.7); padding: 2px 6px; border-radius: 4px; }
</style>
